import math
a = float(input("a? "))
b = float(input("b? "))
c = float(input("c? "))
if(a == 0):
    print("bukan persamaan kuadrat")
else: 
    d = b**2 - 4*a*c
    if(d < 0):
        print("imaginary roots")
        print("(-b + sqrt(d))/2")
        print("(-b - sqrt(d))/2")
    elif(d == 0):
        print("distinct roots")
        xy = (-b)/2
        print(xy)
    else: 
        print("double roots")
        x = (-b + math.sqrt(d))
        y = (-b - math.sqrt(d))
        print(x)
        print(y)
