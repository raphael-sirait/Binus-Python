def add(value1: float, value2: float):
    result = value1 + value2
    return result
def sub(value1: float, value2: float):
    result = value1 - value2
    return result
def mul(value1: float, value2: float):
    result = value1*value2
    return result
def div(value1: float, value2: float):
    result = value1 / value2
    return result
def mod(value1: float, value2: float):
    result = value1 % value2
    return result
